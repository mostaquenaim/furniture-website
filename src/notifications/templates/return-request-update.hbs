<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; border: 1px solid #eaeaea; padding: 24px; background-color: #ffffff;">

  <!-- Brand Header -->
  <div style="text-align:center; margin-bottom: 20px;">
    <h1 style="margin:0; color:#222;">Ondorkotha</h1>
    <p style="margin:0; font-size:14px; color:#777;">Return Request Update</p>
  </div>

  <h2 style="color:#333;">Hello {{customerName}},</h2>

  <div style="
    margin: 25px 0;
    padding: 15px;
    background-color: #f7f7f7;
    border-left: 5px solid #e67e22;
  ">
    <p style="margin:0; font-size:16px;">
      For order <strong>#{{orderId}}</strong>, {{message}}
    </p>
  </div>

  <p>
    If you have any questions, feel free to contact our support team.
  </p>

  <hr style="margin:30px 0; border:none; border-top:1px solid #eee;" />

  <p style="font-size:12px; color:#999;">
    Thank you for shopping with Ondorkotha.
  </p>

</div>
