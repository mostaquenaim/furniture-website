<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; border: 1px solid #eaeaea; padding: 24px; background-color: #ffffff;">

  <!-- Brand -->
  <div style="text-align:center; margin-bottom: 20px;">
    <h1 style="margin:0; color:#222;">Sakigai</h1>
    <p style="margin:0; font-size:14px; color:#777;">Secure Verification</p>
  </div>

  <h2 style="color:#333;">Your Verification Code</h2>

  <p>
    Use the following One-Time Password (OTP) to complete your {{purpose}} process:
  </p>

  <div style="text-align:center; margin: 30px 0;">
    <div style="
      display:inline-block;
      padding:15px 30px;
      font-size:28px;
      letter-spacing:4px;
      font-weight:bold;
      background:#f4f4f4;
      border:1px solid #ddd;
      border-radius:6px;
    ">
      {{otp}}
    </div>
  </div>

  <p>
    This code will expire in <strong>5 minutes</strong>.
  </p>

  <p style="color:#777; font-size:13px;">
    Do not share this code with anyone. Sakigai will never ask for your OTP.
  </p>

  <hr style="margin:30px 0; border:none; border-top:1px solid #eee;" />

  <p style="font-size:12px; color:#999;">
    If you did not request this, please ignore this email.
  </p>

</div>