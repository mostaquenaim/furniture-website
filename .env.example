NODE_ENV=development
# Neon Postgres — pooled connection for app traffic (run `neon env pull` to fill these in)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
# Neon Postgres — direct (unpooled) connection, used by Prisma Migrate
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:7000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=sakigai
PORT=3000

ENABLE_NEW_PAYMENT=true
PAYMENT_PROVIDER=SSLCOMMERZ
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=@ssl
SSLCOMMERZ_IS_LIVE=false

CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=

DEFAULT_DELIVERY_FEE=120

SMTP_PASS=

SMTP_PASS=your_smtp_pass
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
MAIL_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_BASE_URL=

PATHAO_MERCHANT_STORE_ID=

PATHAO_WEBHOOK_SECRET=

# Order status is meant to come only from the courier webhook. Set to "true"
# to let admins override it manually from the admin dashboard instead.
MANUAL_ORDER_STATUS_UPDATE=false

REDX_WEBHOOK_SECRET=
PAPERFLY_WEBHOOK_SECRET=

ADMIN_PASSWORD=

RESEND_API_KEY=

RESEND_FROM_EMAIL=

MIMSMS_API_KEY=
MIMSMS_USERNAME=
MIMSMS_SENDER_NAME=

# Preferred: a full connection URL (e.g. Upstash's rediss:// URL, which
# enables TLS via its scheme). Takes precedence over REDIS_HOST/PORT/etc below.
REDIS_URL=
# Upstash REST API credentials, if used outside the ioredis client.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fallback for local dev when REDIS_URL is not set.
REDIS_HOST=
REDIS_PORT=
# Only needed for managed Redis providers that require auth/TLS.
REDIS_PASSWORD=
REDIS_TLS=false

FRAUD_SPY_BD_API_KEY=-3d86-
FRAUDURL=

COMPANY_NAME=