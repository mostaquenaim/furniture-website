generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// User
// =====================
model User {
  id          Int         @id @default(autoincrement())
  name        String?
  phone       String?     @unique
  email       String?     @unique
  isVerified  Boolean     @default(false)
  password    String?
  googleId    String?     @unique
  avatar      String? // URL to profile picture
  role        UserRole    @default(CUSTOMER)
  fraudStatus FraudStatus @default(SAFE)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  wishlist         Wishlist[]
  orders           Order[]
  otps             OTP[]
  cart             Cart[]
  productViews     ProductView[]
  visitors         Visitor[]
  supportTickets   SupportTicket[]
  activityLogs     ActivityLog[]
  fraudChecks      FraudCheck[]
  stockAdjustments StockAdjustment[]
  searchLogs       SearchLog[]
  pieceStatusEvents PieceStatusEvent[]
  reservationsReserved OrderLineReservation[] @relation("ReservationReservedBy")
  reservationsPicked   OrderLineReservation[] @relation("ReservationPickedBy")
  generationBatches    GenerationBatch[]
}

enum UserRole {
  SUPERADMIN
  PRODUCTMANAGER
  ORDERMANAGER
  INVENTORYMANAGER
  SUPPORT
  CUSTOMER
}

model Visitor {
  id     String @id @default(cuid())
  user   User?  @relation(fields: [userId], references: [id])
  userId Int?

  carts     Cart[]
  views     ProductView[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// =====================
// Permission
// =====================
model RolePermission {
  id        Int      @id @default(autoincrement())
  role      UserRole
  action    String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([role, action])
  @@map("role_permissions")
}

// =====================
// Auth / login
// =====================
model OTP {
  id        Int      @id @default(autoincrement())
  code      String
  email     String?
  type      String // email | phone
  // purpose   String // REGISTER | ADMIN_LOGIN | UPDATE_EMAIL | UPDATE_PHONE
  phone     String?
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model BlackListToken {
  id     Int    @id @default(autoincrement())
  jti    String
  expiry BigInt

  @@index([jti])
}

model LoginAttempt {
  id           String    @id @default(cuid())
  identifier   String // email or IP
  attempts     Int       @default(0)
  blockedUntil DateTime?
  lastAttempt  DateTime  @default(now())

  @@unique([identifier])
}

// =====================
// Category & Subcategory & Room
// =====================
enum SeriesType {
  NORMAL
  SALE
  NEW
}

model Series {
  id     Int     @id @default(autoincrement())
  name   String
  slug   String  @unique
  image  String? // image URL
  notice String?

  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  seriesType SeriesType @default(NORMAL)

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id    Int     @id @default(autoincrement())
  name  String?
  slug  String  @unique
  image String? // image URL

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId Int

  subCategories SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, slug])
}

model SubCategory {
  id    Int     @id @default(autoincrement())
  name  String
  slug  String  @unique
  image String? // image URL

  sortOrder         Int     @default(0)
  isActive          Boolean @default(true)
  isAdvancePayment  Boolean @default(false)
  advancePercentage Int     @default(0)
  isCODAvailable    Boolean @default(true)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products           ProductSubCategory[]
  blogs              SubCategoryBlogs[]
  featuredCategories FeaturedCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
}

model ProductSubCategory {
  productId     Int
  subCategoryId Int

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@id([productId, subCategoryId])
}

// =====================
// Product & Variants
// =====================
model Product {
  id               Int     @id @default(autoincrement())
  title            String
  slug             String  @unique
  sku              String?
  description      String?
  basePrice        Int
  price            Int?
  brand            String?
  weight           Decimal @default(0.50) @db.Decimal(5, 2)
  hasColorVariants Boolean @default(true)
  showColor        Boolean @default(true)

  discountType  String?
  discount      Int       @default(0)
  discountEnd   DateTime?
  discountStart DateTime?

  note             String?
  deliveryEstimate String?
  productDetails   String?
  dimension        String?
  shippingReturn   String?

  totalProductQuantity Int     @default(0)
  isActive             Boolean @default(true)
  isFeatured           Boolean @default(false)
  viewCount            Int     @default(0)
  soldCount            Int     @default(0)
  rating               Decimal @default(0.0) @db.Decimal(3, 2)
  trendScore           Decimal @default(0.0) @db.Decimal(3, 2)
  sortOrder            Int     @default(0)

  material      Material?            @relation(fields: [materialId], references: [id])
  materialId    Int?
  orderItems    OrderItem[]
  wishlists     Wishlist[]
  images        ProductImage[]
  subCategories ProductSubCategory[]
  colors        ProductColor[]
  // reviews       Review[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  productViews     ProductView[]
  productTags      ProductTag[]
  inventoryItems   InventoryItem[]
  stockAdjustments StockAdjustment[]
  flashSaleProducts FlashSaleProduct[]
}

model InventoryItem {
  id String @id @default(uuid())

  // Link to product AND optionally to a specific color/size variant
  productId     Int
  product       Product      @relation(fields: [productId], references: [id])
  productSizeId Int? // ← ADD THIS — null means "any variant"
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id])

  barcode String @unique // move to product level ideally, but ok here

  // Replace free-text with a relation
  locationId  String?
  location    WarehouseLocation? @relation(fields: [locationId], references: [id])
  barcodeType BarcodeType        @default(CODE128)

  quantity   Int @default(0)
  lowStockAt Int @default(5) // ← ADD THIS

  // Label print info
  lotNumber   String?
  packingDate DateTime?

  // Audit
  lastCountedAt DateTime? // ← ADD THIS — last physical stock count
  printCount    Int       @default(0)
  printedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // ← ADD THIS — was missing
}

enum BarcodeType {
  CODE128
  QR
  EAN13
}

model WarehouseLocation {
  id    String  @id @default(cuid())
  code  String  @unique // e.g. "A-03-B-02" (zone-aisle-shelf-bin)
  zone  String
  aisle String
  shelf String
  bin   String
  label String? // "Dining Tables North"

  items  InventoryItem[]
  pieces Piece[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pieces Piece[]
}

// One row per physical unit — the piece-level counterpart to InventoryItem
// (which remains a per-lot/SKU record for ProductSize rows still on
// LEGACY_QUANTITY tracking). Every status transition is written by
// PieceService and logged to PieceStatusEvent; transitions that affect
// sellable count go through the existing StockLedgerService so
// ProductSize.quantity — the number checkout actually reads — never
// diverges from piece reality.
model Piece {
  id           Int         @id @default(autoincrement())
  barcodeValue String      @unique

  productSizeId Int
  productSize   ProductSize @relation(fields: [productSizeId], references: [id])

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  status PieceStatus @default(CREATED)

  locationId String?
  location   WarehouseLocation? @relation(fields: [locationId], references: [id])

  // Groups pieces received together in one scan session; nullable since a
  // piece isn't received yet at CREATED.
  receiveBatchId String?

  // The print run this piece was generated in — lets receiving reconcile
  // "how many did we print vs. how many actually showed up" per run.
  generateBatchId String?
  generateBatch   GenerationBatch? @relation(fields: [generateBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents PieceStatusEvent[]
  reservations OrderLineReservation[]

  @@index([productSizeId, status])
  @@index([locationId])
  @@index([generateBatchId])
}

// One row per `generatePieces()` call — the expected quantity for that print
// run, so receiving/void/stale-alert flows can reconcile against it instead
// of only seeing loose CREATED pieces with no notion of "which batch."
model GenerationBatch {
  id            String @id @default(uuid())
  productSizeId Int
  productSize   ProductSize @relation(fields: [productSizeId], references: [id])

  quantity Int

  createdByUserId Int?
  createdBy       User? @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  pieces Piece[]

  @@index([productSizeId])
}

model PieceStatusEvent {
  id      Int   @id @default(autoincrement())
  pieceId Int
  piece   Piece @relation(fields: [pieceId], references: [id])

  fromStatus PieceStatus?
  toStatus   PieceStatus

  actorUserId Int?
  actor       User?     @relation(fields: [actorUserId], references: [id])
  actorRole   UserRole?

  source     String // "SCAN" | "WEBHOOK" | "SYSTEM"
  reasonCode String?
  note       String?

  createdAt DateTime @default(now())

  @@index([pieceId])
}

enum PieceStatus {
  CREATED
  DAMAGED_INCOMING
  IN_STOCK
  RESERVED
  PICKED
  SHIPPED
  DELIVERED
  RETURNING
  RETURNED_IN_STOCK
  DAMAGED_RETURN
  VOID
}

// One per order — groups every reserved Piece for that order so "has
// everything been physically picked" is a single query instead of tracking
// N independent reservations. `isFullyPicked` is deliberately NOT a stored
// field on this model — it's computed live by ReservationService against
// the order's piece-tracked line items, so it can never drift out of sync
// with the underlying reservations the way a cached flag could.
model ShipmentGroup {
  id      Int                 @id @default(autoincrement())
  orderId Int                 @unique
  order   Order               @relation(fields: [orderId], references: [id])
  status  ShipmentGroupStatus @default(OPEN)

  courierShipmentId Int?             @unique
  courierShipment   CourierShipment? @relation(fields: [courierShipmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations OrderLineReservation[]
}

enum ShipmentGroupStatus {
  OPEN
  SHIPPED
}

// One row per physical unit fulfilling one order line — an OrderItem with
// quantity 3 gets 3 rows, each bound to a distinct Piece (pieceId is
// unique: a piece can never fulfill more than one order line at once).
model OrderLineReservation {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  // NOT unique: a physical piece is sold, delivered, and (sometimes) returned
  // many times over its life, and each cycle gets its own reservation row for
  // history. At most one row per piece has pickedAt: null at any given time —
  // that's "the active reservation" — enforced by Piece.status (RESERVED),
  // not by a DB constraint on this table.
  pieceId Int
  piece   Piece @relation(fields: [pieceId], references: [id])

  shipmentGroupId Int
  shipmentGroup   ShipmentGroup @relation(fields: [shipmentGroupId], references: [id])

  reservedAt       DateTime @default(now())
  reservedByUserId Int?
  reservedBy       User?    @relation("ReservationReservedBy", fields: [reservedByUserId], references: [id])

  pickedAt       DateTime?
  pickedByUserId Int?
  pickedBy       User?     @relation("ReservationPickedBy", fields: [pickedByUserId], references: [id])

  @@index([shipmentGroupId])
  @@index([orderItemId])
  @@index([pieceId])
}

model StockAdjustment {
  id Int @id @default(autoincrement())

  productSizeId Int
  productSize   ProductSize @relation(fields: [productSizeId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  delta         Int // negative = decrement, positive = increment
  quantityAfter Int // ProductSize.quantity immediately after this adjustment
  reason        StockAdjustReason
  note          String?

  adminId Int? // null for system-driven adjustments (order placed/cancelled)
  admin   User? @relation(fields: [adminId], references: [id])

  createdAt DateTime @default(now())

  @@index([productSizeId])
  @@index([productId])
  @@index([createdAt])
}

enum StockAdjustReason {
  RESTOCK
  CORRECTION
  DAMAGE
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_RETURNED
  OTHER
}

model Tag {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  // slug     String  @unique
  isActive Boolean @default(true)

  products ProductTag[]
  blogs    BlogPostTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductTag {
  productId Int
  tagId     Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductView {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id])
  productId Int

  user   User? @relation(fields: [userId], references: [id])
  userId Int?

  visitor   Visitor? @relation(fields: [visitorId], references: [id])
  visitorId String?

  viewCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId, visitorId])
}

model SearchLog {
  id Int @id @default(autoincrement())

  keyword      String
  resultsCount Int    @default(0)

  user   User? @relation(fields: [userId], references: [id])
  userId Int?

  createdAt DateTime @default(now())

  @@index([keyword])
  @@index([createdAt])
}

model Material {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  slug     String  @unique
  order    Int     @default(0)
  isActive Boolean @default(true)

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model ProductImage {
  id       Int    @id @default(autoincrement())
  image    String
  serialNo Int    @default(0)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductColor {
  id               Int     @id @default(autoincrement())
  useDefaultImages Boolean @default(true)

  color   Color @relation(fields: [colorId], references: [id])
  colorId Int

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  images ProductColorImage[]
  sizes  ProductSize[]
}

model ProductColorImage {
  id       Int    @id @default(autoincrement())
  image    String
  serialNo Int    @default(0)

  productColorId Int
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
}

model Color {
  id        Int     @id @default(autoincrement())
  name      String
  hexCode   String?
  image     String?
  sortOrder Int     @default(0)

  productColor ProductColor[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ProductSize {
  id Int @id @default(autoincrement())

  sku String?

  discountType String?
  discount     Int     @default(0)
  basePrice    Int?
  price        Int?
  quantity     Int     @default(0)
  lowStockAt   Int     @default(5)

  soldCount Int @default(0)

  // Piece-level barcode tracking (see Piece model): LEGACY_QUANTITY keeps
  // using this row's `quantity` column directly (today's behavior, unchanged
  // for existing variants); PIECE_BARCODE means `quantity` is derived from
  // counting related Piece rows with status IN_STOCK and mutated only via
  // PieceService going through StockLedgerService, never adjusted directly.
  trackingMode ProductTrackingMode @default(LEGACY_QUANTITY)

  sizeId Int
  size   Size @relation(fields: [sizeId], references: [id])

  colorId          Int
  color            ProductColor      @relation(fields: [colorId], references: [id], onDelete: Cascade)
  cartItems        CartItem[]
  inventoryItems   InventoryItem[]
  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]
  pieces           Piece[]
  generationBatches GenerationBatch[]
}

enum ProductTrackingMode {
  LEGACY_QUANTITY
  PIECE_BARCODE
}

model Variant {
  id    Int    @id @default(autoincrement())
  name  String
  sizes Size[] // one-to-many relation

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Size {
  id        Int     @id @default(autoincrement())
  name      String
  variantId Int
  variant   Variant @relation(fields: [variantId], references: [id])

  productSize ProductSize[]

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// =====================
// Cart
// =====================
model Cart {
  id        Int     @id @default(autoincrement())
  user      User?   @relation(fields: [userId], references: [id])
  userId    Int?
  userEmail String?

  baseSubtotalAtAdd Int @default(0)
  subtotalAtAdd     Int @default(0)

  coupon   Coupon? @relation(fields: [couponId], references: [id])
  couponId Int?

  items     CartItem[]
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  visitor   Visitor?   @relation(fields: [visitorId], references: [id])
  visitorId String?

  @@index([userId, visitorId, status])
}

model CartItem {
  id     Int  @id @default(autoincrement())
  cart   Cart @relation(fields: [cartId], references: [id])
  cartId Int

  quantity Int @default(1)

  basePriceAtAdd    Int
  baseSubtotalAtAdd Int

  priceAtAdd    Int
  subtotalAtAdd Int

  color String?
  size  String?

  productSize   ProductSize @relation(fields: [productSizeId], references: [id])
  productSizeId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productSizeId])
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

// =====================
// Orders
// =====================
model Order {
  id Int @id @default(autoincrement())

  userId        Int?
  orderId       String @unique
  trackingToken String @unique

  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String

  districtId   Int?
  district     City?   @relation(fields: [districtId], references: [id])
  districtName String?

  zoneId   Int?
  zoneName String?

  areaId   Int?
  areaName String?

  postCode String?

  // ── Delivery
  deliveryMethod String?
  deliveryCharge Float?

  // ── Pricing
  couponCode String?
  discount   Float?
  total      Float

  // ── Status
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // ── Advance payment (COD only — see SubCategory.isAdvancePayment)
  advanceRequired   Boolean @default(false)
  advancePercentage Int     @default(0)
  advanceAmount     Float   @default(0)
  remainingAmount   Float   @default(0)

  // ── Courier
  awbNumber String? // courier AWB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockRestored Boolean @default(false)

  user                 User?                @relation(fields: [userId], references: [id])
  items                OrderItem[]
  payments             Payment[]
  orderStatusHistories OrderStatusHistory[]
  invoice              Invoice?
  courierShipments     CourierShipment[]
  returnRequests       ReturnRequest[]
  shipmentGroup        ShipmentGroup?
}

model OrderItem {
  id      Int @id @default(autoincrement())
  orderId Int

  product      Product @relation(fields: [productId], references: [id])
  productId    Int
  productTitle String // snapshot
  sku          String?

  color      String?
  size       String?
  isReviewed Boolean @default(false)

  productSizeId Int?
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id])

  quantity             Int
  priceAtPurchase      Int
  basePriceAtPurchase  Int
  totalPriceAtPurchase Int

  order  Order   @relation(fields: [orderId], references: [id])
  review Review?

  returnRequestItems ReturnRequestItem[]
  reservations        OrderLineReservation[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
  RETURNED
  ON_HOLD
  PARTIALLY_DELIVERED
  RETURN_REQUESTED
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  note      String? // optional admin note
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// =====================
// Returns & Refunds
// =====================
// A customer-initiated request to return one or more items from a delivered
// order. Approval/receipt and the eventual refund are tracked as separate
// steps so an admin never refunds money before the goods are actually back
// in the warehouse.
model ReturnRequest {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  requestedBy Int? // customer User id who filed the request
  reason      String
  note        String? // customer-provided detail

  // Order.status captured at the moment this request was filed (always
  // DELIVERED or PARTIALLY_DELIVERED) — restored verbatim if the request is
  // later rejected or cancelled, instead of guessing what it used to be.
  previousOrderStatus OrderStatus

  status ReturnRequestStatus @default(PENDING)

  items   ReturnRequestItem[]
  refunds PaymentRefund[]

  adminNote  String? // internal note set on approve/reject/receive
  reviewedBy Int? // admin User id who approved/rejected
  reviewedAt DateTime?
  receivedBy Int? // admin User id who confirmed physical receipt
  receivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

model ReturnRequestItem {
  id Int @id @default(autoincrement())

  returnRequestId Int
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  quantity Int

  @@unique([returnRequestId, orderItemId])
}

enum ReturnRequestStatus {
  PENDING // awaiting admin review
  APPROVED // admin accepted the return — awaiting the physical item(s)
  REJECTED // admin declined the return — terminal
  ITEM_RECEIVED // warehouse confirmed receipt — ready to refund
  REFUNDED // refund issued for this request — terminal
  CANCELLED // customer withdrew the request while it was still PENDING — terminal
}

model Invoice {
  id        String @id @default(uuid())
  invoiceNo String @unique
  orderId   Int    @unique
  order     Order  @relation(fields: [orderId], references: [id])

  subtotal     Float
  discount     Float
  shippingCost Float
  tax          Float
  total        Float

  dueDate   DateTime?
  paidAt    DateTime?
  issuedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
}

enum DeliveryMethod {
  HOME
  PICKUP
  COURIER
}

model City {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  isActive       Boolean       @default(true)
  deliveryFee    Int           @default(120)
  isCODAvailable Boolean       @default(true)
