// =====================
// COMPANY INFO
// =====================
// Singleton row (id always 1) holding global, admin-editable defaults that
// aren't tied to a specific district/subcategory — e.g. the fallback
// delivery fee used when a new district is created without one.
model AppSettings {
  id Int @id @default(autoincrement())

  defaultDeliveryFee Float @default(120)

  // Courier delivery label — single configurable size used for every
  // shipment label print (see CourierShipment label printing).
  courierLabelWidthMm  Float @default(100)
  courierLabelHeightMm Float @default(150)

  // Invoice print/PDF paper size. "A4" | "LETTER" | "CUSTOM" — width/height
  // are only read when CUSTOM.
  invoicePaperSize     String @default("A4")
  invoicePaperWidthMm  Float?
  invoicePaperHeightMm Float?

  updatedAt DateTime @updatedAt
}

// Saved, admin-managed product barcode label presets (name + physical
// size in mm) used by the Print Labels screen. Exactly one row should be
// isDefault at a time — enforced in LabelSizeService, not at the DB level.
model LabelSize {
  id        Int      @id @default(autoincrement())
  name      String
  widthMm   Float
  heightMm  Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("label_sizes")
}

model CompanyInfo {
  id Int @id @default(autoincrement())

  // Basic
  name          String  @default("Ondorkotha")
  logo          String? // Cloudinary URL
  favicon       String? // Cloudinary URL
  tagline       String?
  about         String? @db.Text
  privacyPolicy String? @db.Text

  // Contact
  email        String?
  phone        String?
  whatsapp     String?
  address      String?
  city         String?
  country      String?
  googleMapUrl String?

  // Social
  facebook  String?
  instagram String?
  youtube   String?
  tiktok    String?
  twitter   String?
  linkedin  String?

  // SEO
  metaTitle       String?
  metaDescription String?
  ogImage         String? // Open Graph image URL

  updatedAt DateTime @updatedAt
  updatedBy Int? // last admin user id

  @@map("company_info")
}

