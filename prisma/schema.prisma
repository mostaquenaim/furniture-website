generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                   Int                    @id @default(autoincrement())
  name                 String?
  phone                String?                @unique
  email                String?                @unique
  password             String?
  role                 UserRole               @default(CUSTOMER)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  isActive             Boolean                @default(true)
  isVerified           Boolean                @default(false)
  googleId             String?                @unique
  avatar               String?
  fraudStatus          FraudStatus            @default(SAFE)
  activityLogs         ActivityLog[]
  apiClientsCreated    ApiClient[]
  cart                 Cart[]
  fraudChecks          FraudCheck[]
  generationBatches    GenerationBatch[]
  otps                 OTP[]
  orders               Order[]
  reservationsPicked   OrderLineReservation[] @relation("ReservationPickedBy")
  reservationsReserved OrderLineReservation[] @relation("ReservationReservedBy")
  pieceStatusEvents    PieceStatusEvent[]
  productViews         ProductView[]
  searchLogs           SearchLog[]
  stockAdjustments     StockAdjustment[]
  assignedTickets      SupportTicket[]        @relation("TicketAssignee")
  supportTickets       SupportTicket[]
  ticketMessages       SupportTicketMessage[] @relation("TicketMessageAuthor")
  visitors             Visitor[]
  wishlist             Wishlist[]
}

model Visitor {
  id        String        @id @default(cuid())
  userId    Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  carts     Cart[]
  orders    Order[]
  views     ProductView[]
  user      User?         @relation(fields: [userId], references: [id])
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  role      UserRole
  action    String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([role, action])
  @@map("role_permissions")
}

model ApiClient {
  id                 Int                @id @default(autoincrement())
  name               String
  keyPrefix          String             @unique
  hashedSecret       String
  scopes             String[]
  status             ApiClientStatus    @default(ACTIVE)
  rateLimitPerMinute Int                @default(60)
  expiresAt          DateTime?
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdByAdminId   Int
  createdAt          DateTime           @default(now())
  createdBy          User               @relation(fields: [createdByAdminId], references: [id])
  requestLogs        ApiKeyRequestLog[]
}

model ApiKeyRequestLog {
  id          Int       @id @default(autoincrement())
  apiClientId Int
  method      String
  path        String
  statusCode  Int
  ipAddress   String?
  createdAt   DateTime  @default(now())
  apiClient   ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  @@index([apiClientId, createdAt])
}

model OTP {
  id        Int      @id @default(autoincrement())
  code      String
  type      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    Int?
  email     String?
  phone     String?
  attempts  Int      @default(0)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([phone, type, createdAt])
}

model BlackListToken {
  id     Int    @id @default(autoincrement())
  jti    String
  expiry BigInt

  @@index([jti])
}

model LoginAttempt {
  id           String    @id @default(cuid())
  identifier   String    @unique
  attempts     Int       @default(0)
  blockedUntil DateTime?
  lastAttempt  DateTime  @default(now())
}

model Series {
  id         Int        @id @default(autoincrement())
  name       String
  slug       String     @unique
  image      String?
  notice     String?
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  seriesType SeriesType @default(NORMAL)
  categories Category[]
}

model Category {
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  createdAt     DateTime         @default(now())
  image         String?
  isActive      Boolean          @default(true)
  seriesId      Int
  sortOrder     Int              @default(0)
  updatedAt     DateTime         @updatedAt
  name          String?
  series        Series           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  coupons       CouponCategory[]
  subCategories SubCategory[]

  @@unique([seriesId, slug])
}

model SubCategory {
  id                 Int                  @id @default(autoincrement())
  name               String
  slug               String               @unique
  image              String?
  sortOrder          Int                  @default(0)
  isActive           Boolean              @default(true)
  categoryId         Int
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  advancePercentage  Int                  @default(0)
  isAdvancePayment   Boolean              @default(false)
  isCODAvailable     Boolean              @default(true)
  featuredCategories FeaturedCategory[]
  products           ProductSubCategory[]
  category           Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  blogs              SubCategoryBlogs[]

  @@unique([categoryId, slug])
}

model ProductSubCategory {
  productId     Int
  subCategoryId Int
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@id([productId, subCategoryId])
}

model Product {
  id                   Int                  @id @default(autoincrement())
  title                String
  slug                 String               @unique
  description          String?
  basePrice            Int
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  showColor            Boolean              @default(true)
  sku                  String?
  hasColorVariants     Boolean              @default(true)
  deliveryEstimate     String?
  dimension            String?
  discount             Int                  @default(0)
  discountEnd          DateTime?
  discountStart        DateTime?
  isActive             Boolean              @default(true)
  note                 String?
  productDetails       String?
  shippingReturn       String?
  materialId           Int?
  viewCount            Int                  @default(0)
  price                Int?
  rating               Decimal              @default(0.0) @db.Decimal(3, 2)
  sortOrder            Int                  @default(0)
  trendScore           Decimal              @default(0.0) @db.Decimal(3, 2)
  soldCount            Int                  @default(0)
  totalProductQuantity Int                  @default(0)
  isFeatured           Boolean              @default(false)
  discountType         String?
  brand                String?
  weight               Decimal              @default(0.5) @db.Decimal(5, 2)
  flashSaleProducts    FlashSaleProduct[]
  inventoryItems       InventoryItem[]
  orderItems           OrderItem[]
  material             Material?            @relation(fields: [materialId], references: [id])
  colors               ProductColor[]
  images               ProductImage[]
  subCategories        ProductSubCategory[]
  productTags          ProductTag[]
  productViews         ProductView[]
  stockAdjustments     StockAdjustment[]
  wishlists            Wishlist[]
}

model InventoryItem {
  id            String             @id @default(uuid())
  barcode       String             @unique
  quantity      Int                @default(0)
  createdAt     DateTime           @default(now())
  productSizeId Int?
  lastCountedAt DateTime?
  locationId    String?
  lowStockAt    Int                @default(5)
  printCount    Int                @default(0)
  printedAt     DateTime?
  productId     Int
  updatedAt     DateTime           @updatedAt
  barcodeType   BarcodeType        @default(CODE128)
  lotNumber     String?
  packingDate   DateTime?
  location      WarehouseLocation? @relation(fields: [locationId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  productSize   ProductSize?       @relation(fields: [productSizeId], references: [id])
}

model WarehouseLocation {
  id        String          @id @default(cuid())
  code      String          @unique
  zone      String
  aisle     String
  shelf     String
  bin       String
  label     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     InventoryItem[]
  pieces    Piece[]
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pieces      Piece[]
}

model Piece {
  id              Int                    @id @default(autoincrement())
  barcodeValue    String                 @unique
  productSizeId   Int
  supplierId      Int?
  status          PieceStatus            @default(CREATED)
  locationId      String?
  receiveBatchId  String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  generateBatchId String?
  reservations    OrderLineReservation[]
  generateBatch   GenerationBatch?       @relation(fields: [generateBatchId], references: [id])
  location        WarehouseLocation?     @relation(fields: [locationId], references: [id])
  productSize     ProductSize            @relation(fields: [productSizeId], references: [id])
  supplier        Supplier?              @relation(fields: [supplierId], references: [id])
  statusEvents    PieceStatusEvent[]

  @@index([productSizeId, status])
  @@index([locationId])
  @@index([generateBatchId])
}

model GenerationBatch {
  id              String      @id @default(uuid())
  productSizeId   Int
  quantity        Int
  createdByUserId Int?
  createdAt       DateTime    @default(now())
  createdBy       User?       @relation(fields: [createdByUserId], references: [id])
  productSize     ProductSize @relation(fields: [productSizeId], references: [id])
  pieces          Piece[]

  @@index([productSizeId])
}

model PieceStatusEvent {
  id          Int          @id @default(autoincrement())
  pieceId     Int
  fromStatus  PieceStatus?
  toStatus    PieceStatus
  actorUserId Int?
  actorRole   UserRole?
  source      String
  reasonCode  String?
  note        String?
  createdAt   DateTime     @default(now())
  actor       User?        @relation(fields: [actorUserId], references: [id])
  piece       Piece        @relation(fields: [pieceId], references: [id])

  @@index([pieceId])
}

model ShipmentGroup {
  id                Int                    @id @default(autoincrement())
  orderId           Int                    @unique
  status            ShipmentGroupStatus    @default(OPEN)
  courierShipmentId Int?                   @unique
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  pickSlipSentAt    DateTime?
  reservations      OrderLineReservation[]
  courierShipment   CourierShipment?       @relation(fields: [courierShipmentId], references: [id])
  order             Order                  @relation(fields: [orderId], references: [id])
}

model OrderLineReservation {
  id               Int           @id @default(autoincrement())
  orderItemId      Int
  pieceId          Int
  shipmentGroupId  Int
  reservedAt       DateTime      @default(now())
  reservedByUserId Int?
  pickedAt         DateTime?
  pickedByUserId   Int?
  orderItem        OrderItem     @relation(fields: [orderItemId], references: [id])
  pickedBy         User?         @relation("ReservationPickedBy", fields: [pickedByUserId], references: [id])
  piece            Piece         @relation(fields: [pieceId], references: [id])
  reservedBy       User?         @relation("ReservationReservedBy", fields: [reservedByUserId], references: [id])
  shipmentGroup    ShipmentGroup @relation(fields: [shipmentGroupId], references: [id])

  @@index([shipmentGroupId])
  @@index([orderItemId])
  @@index([pieceId])
}

model StockAdjustment {
  id            Int               @id @default(autoincrement())
  productSizeId Int
  productId     Int
  delta         Int
  quantityAfter Int
  reason        StockAdjustReason
  note          String?
  adminId       Int?
  createdAt     DateTime          @default(now())
  admin         User?             @relation(fields: [adminId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  productSize   ProductSize       @relation(fields: [productSizeId], references: [id])

  @@index([productSizeId])
  @@index([productId])
  @@index([createdAt])
}

model Tag {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  blogs     BlogPostTag[]
  products  ProductTag[]
}

model ProductTag {
  productId Int
  tagId     Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductView {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int?
  viewCount Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visitorId String?
  product   Product  @relation(fields: [productId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
  visitor   Visitor? @relation(fields: [visitorId], references: [id])

  @@unique([productId, userId, visitorId])
}

model SearchLog {
  id           Int      @id @default(autoincrement())
  keyword      String
  resultsCount Int      @default(0)
  userId       Int?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([keyword])
  @@index([createdAt])
}

model Material {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  products  Product[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  image     String
  productId Int
  serialNo  Int     @default(0)
  alt       String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductColor {
  id               Int                 @id @default(autoincrement())
  colorId          Int
  productId        Int
  useDefaultImages Boolean             @default(true)
  color            Color               @relation(fields: [colorId], references: [id])
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  images           ProductColorImage[]
  sizes            ProductSize[]
}

model ProductColorImage {
  id             Int          @id @default(autoincrement())
  image          String
  productColorId Int
  serialNo       Int          @default(0)
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
}

model Color {
  id           Int            @id @default(autoincrement())
  name         String
  hexCode      String?
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  isActive     Boolean        @default(true)
  image        String?
  productColor ProductColor[]
}

model ProductSize {
  id                Int                 @id @default(autoincrement())
  sku               String?
  price             Int
  colorId           Int
  sizeId            Int
  quantity          Int                 @default(0)
  basePrice         Int
  soldCount         Int                 @default(0)
  discount          Int                 @default(0)
  discountType      String?
  lowStockAt        Int                 @default(5)
  trackingMode      ProductTrackingMode @default(LEGACY_QUANTITY)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  weight            Decimal?            @db.Decimal(6, 2)
  cartItems         CartItem[]
  generationBatches GenerationBatch[]
  inventoryItems    InventoryItem[]
  orderItems        OrderItem[]
  pieces            Piece[]
  color             ProductColor        @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size              Size                @relation(fields: [sizeId], references: [id])
  stockAdjustments  StockAdjustment[]
}

model Variant {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  sizes     Size[]
}

model Size {
  id          Int           @id @default(autoincrement())
  name        String
  variantId   Int
  createdAt   DateTime      @default(now())
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  productSize ProductSize[]
  variant     Variant       @relation(fields: [variantId], references: [id])
}

model Cart {
  id                Int        @id @default(autoincrement())
  userId            Int?
  updatedAt         DateTime   @updatedAt
  createdAt         DateTime   @default(now())
  status            CartStatus @default(ACTIVE)
  userEmail         String?
  baseSubtotalAtAdd Int        @default(0)
  subtotalAtAdd     Int        @default(0)
  couponId          Int?
  visitorId         String?
  coupon            Coupon?    @relation(fields: [couponId], references: [id])
  user              User?      @relation(fields: [userId], references: [id])
  visitor           Visitor?   @relation(fields: [visitorId], references: [id])
  items             CartItem[]

  @@index([userId, visitorId, status])
}

model CartItem {
  id                Int         @id @default(autoincrement())
  cartId            Int
  quantity          Int         @default(1)
  priceAtAdd        Int
  productSizeId     Int
  color             String?
  size              String?
  basePriceAtAdd    Int
  baseSubtotalAtAdd Int
  createdAt         DateTime    @default(now())
  subtotalAtAdd     Int
  updatedAt         DateTime    @updatedAt
  cart              Cart        @relation(fields: [cartId], references: [id])
  productSize       ProductSize @relation(fields: [productSizeId], references: [id])

  @@unique([cartId, productSizeId])
}

model Order {
  id                   Int                  @id @default(autoincrement())
  userId               Int?
  total                Float
  status               OrderStatus          @default(PENDING)
  awbNumber            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  customerEmail        String?
  customerName         String
  customerPhone        String
  deliveryCharge       Float?
  shippingAddress      String
  districtId           Int?
  couponCode           String?
  discount             Float?
  districtName         String?
  orderId              String               @unique
  trackingToken        String               @unique
  deliveryMethod       String?
  paymentStatus        PaymentStatus        @default(PENDING)
  postCode             String?
  areaId               Int?
  areaName             String?
  zoneId               Int?
  zoneName             String?
  stockRestored        Boolean              @default(false)
  advanceAmount        Float                @default(0)
  advancePercentage    Int                  @default(0)
  advanceRequired      Boolean              @default(false)
  remainingAmount      Float                @default(0)
  couponId             Int?
  visitorId            String?
  courierShipments     CourierShipment[]
  invoice              Invoice?
  coupon               Coupon?              @relation(fields: [couponId], references: [id])
  district             City?                @relation(fields: [districtId], references: [id])
  user                 User?                @relation(fields: [userId], references: [id])
  visitor              Visitor?             @relation(fields: [visitorId], references: [id])
  items                OrderItem[]
  orderStatusHistories OrderStatusHistory[]
  payments             Payment[]
  returnRequests       ReturnRequest[]
  shipmentGroup        ShipmentGroup?

  @@index([couponId, userId])
  @@index([visitorId, createdAt])
}

model OrderItem {
  id                   Int                    @id @default(autoincrement())
  orderId              Int
  productId            Int
  quantity             Int
  color                String?
  productTitle         String
  size                 String?
  sku                  String?
  basePriceAtPurchase  Int
  priceAtPurchase      Int
  totalPriceAtPurchase Int
  isReviewed           Boolean                @default(false)
  productSizeId        Int?
  order                Order                  @relation(fields: [orderId], references: [id])
  product              Product                @relation(fields: [productId], references: [id])
  productSize          ProductSize?           @relation(fields: [productSizeId], references: [id])
  reservations         OrderLineReservation[]
  returnRequestItems   ReturnRequestItem[]
  review               Review?
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ReturnRequest {
  id                  Int                 @id @default(autoincrement())
  orderId             Int
  requestedBy         Int?
  reason              String
  note                String?
  status              ReturnRequestStatus @default(PENDING)
  adminNote           String?
  reviewedBy          Int?
  reviewedAt          DateTime?
  receivedBy          Int?
  receivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  previousOrderStatus OrderStatus
  refunds             PaymentRefund[]
  order               Order               @relation(fields: [orderId], references: [id])
  items               ReturnRequestItem[]

  @@index([orderId])
  @@index([status])
}

model ReturnRequestItem {
  id              Int           @id @default(autoincrement())
  returnRequestId Int
  orderItemId     Int
  quantity        Int
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderItemId])
}

model Invoice {
  id           String    @id @default(uuid())
  invoiceNo    String    @unique
  orderId      Int       @unique
  subtotal     Float
  discount     Float
  shippingCost Float
  tax          Float
  total        Float
  issuedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  dueDate      DateTime?
  paidAt       DateTime?
  order        Order     @relation(fields: [orderId], references: [id])
}

model City {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deliveryFee    Int           @default(120)
  isCODAvailable Boolean       @default(true)
  courierRates   CourierRate[]
  orders         Order[]
  zones          Zone[]

  @@map("District")
}

model Zone {
  id           Int    @id @default(autoincrement())
  name         String
  pathaoZoneId Int    @unique
  cityId       Int
  areas        Area[]
  city         City   @relation(fields: [cityId], references: [id])
}

model Area {
  id           Int    @id @default(autoincrement())
  name         String
  pathaoAreaId Int    @unique
  zoneId       Int
  zone         Zone   @relation(fields: [zoneId], references: [id])
}

model Coupon {
  id            Int                @id @default(autoincrement())
  code          String             @unique
  discountType  CouponDiscountType
  discountValue Float?
  minOrderValue Float?
  maxDiscount   Float?
  expiryDate    DateTime
  startDate     DateTime           @default(now())
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  perUserLimit  Int?
  usageLimit    Int?
  usedCount     Int                @default(0)
  carts         Cart[]
  categories    CouponCategory[]
  orders        Order[]
}

model CouponCategory {
  id         Int      @id @default(autoincrement())
  couponId   Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
}

model CourierProvider {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  displayName String
  logo        String?
  isActive    Boolean           @default(true)
  priority    Int               @default(0)
  config      Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  rates       CourierRate[]
  shipments   CourierShipment[]
}

model CourierShipment {
  id                  Int                 @id @default(autoincrement())
  orderId             Int
  providerId          Int
  consignmentId       String?
  trackingNumber      String?
  trackingUrl         String?
  labelUrl            String?
  manifestUrl         String?
  status              CourierStatus       @default(PENDING)
  providerStatus      String?
  lastSyncAt          DateTime?
  deliveredAt         DateTime?
  deliveryCharge      Float?
  codAmount           Float?
  errorMessage        String?
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deliveryType        Int?
  itemDescription     String?
  itemType            Int?
  recipientAddress    String?
  recipientName       String?
  recipientPhone      String?
  weight              Float?
  special_instruction String?
  order               Order               @relation(fields: [orderId], references: [id])
  provider            CourierProvider     @relation(fields: [providerId], references: [id])
  courierWebhookLogs  CourierWebhookLog[]
  shipmentGroup       ShipmentGroup?

  @@unique([orderId, providerId])
  @@index([trackingNumber])
}

model CourierWebhookLog {
  id          Int              @id @default(autoincrement())
  provider    String
  eventType   String
  payload     Json
  processed   Boolean          @default(false)
  processedAt DateTime?
  error       String?
  shipmentId  Int?
  createdAt   DateTime         @default(now())
  shipment    CourierShipment? @relation(fields: [shipmentId], references: [id])
}

model AdminNotification {
  id        Int       @id @default(autoincrement())
  type      String
  title     String
  message   String
  link      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
}

model ContactMessage {
  id          Int       @id @default(autoincrement())
  name        String
  email       String
  orderNumber String?
  subject     String
  message     String
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([handledAt])
  @@index([email, createdAt])
  @@index([createdAt])
}

model CourierRate {
  id           Int             @id @default(autoincrement())
  providerId   Int
  districtId   Int?
  weightMin    Float
  weightMax    Float
  price        Float
  codFee       Float?
  deliveryTime String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  district     City?           @relation(fields: [districtId], references: [id])
  provider     CourierProvider @relation(fields: [providerId], references: [id])
}

model Payment {
  id                  Int                @id @default(autoincrement())
  orderId             Int
  method              PaymentMethod
  status              PaymentStatus      @default(PENDING)
  amount              Float
  currency            String             @default("BDT")
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  collectedAt         DateTime?
  collectedBy         String?
  completedAt         DateTime?
  convenienceFee      Float?             @default(0)
  dueAmount           Float              @default(0)
  failedAt            DateTime?
  gateway             String?
  gatewayBatchId      String?
  gatewayRefId        String?
  gatewayResponse     Json?
  gatewayTranId       String?
  initiatedAt         DateTime           @default(now())
  lastRetryAt         DateTime?
  metadata            Json?
  methodDetails       Json?
  notes               String?
  paidAmount          Float              @default(0)
  paymentSettlementId Int?
  rawResponse         Json?
  refundedAt          DateTime?
  retryCount          Int                @default(0)
  riskLevel           RiskLevel?         @default(LOW)
  transactionId       String             @unique
  updatedAt           DateTime           @updatedAt
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  verifiedAt          DateTime?
  phase               PaymentPhase       @default(FULL)
  order               Order              @relation(fields: [orderId], references: [id])
  paymentSettlement   PaymentSettlement? @relation(fields: [paymentSettlementId], references: [id])
  paymentLogs         PaymentLog[]
  refunds             PaymentRefund[]

  @@index([orderId])
  @@index([gatewayTranId])
  @@index([transactionId])
  @@index([status])
  @@index([createdAt])
}

model PaymentRefund {
  id              Int            @id @default(autoincrement())
  paymentId       Int
  amount          Float
  reason          String?
  status          RefundStatus   @default(PENDING)
  gatewayRefundId String?
  requestedBy     Int?
  processedBy     Int?
  processedAt     DateTime?
  notes           String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  gatewayResponse Json?
  refundMethod    RefundMethod   @default(MANUAL)
  returnRequestId Int?
  payment         Payment        @relation(fields: [paymentId], references: [id])
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([paymentId])
  @@index([returnRequestId])
  @@index([status])
}

model PaymentLog {
  id              Int      @id @default(autoincrement())
  paymentId       Int
  action          String
  status          String
  message         String?
  gatewayResponse Json?
  ipAddress       String?
  userAgent       String?
  createdBy       Int?
  createdAt       DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id])
}

model PaymentMethodConfig {
  id                  Int           @id @default(autoincrement())
  method              PaymentMethod
  gateway             String
  isEnabled           Boolean       @default(true)
  isSandbox           Boolean       @default(false)
  displayName         String
  displayOrder        Int           @default(0)
  minAmount           Float?
  maxAmount           Float?
  convenienceFeeType  FeeType?
  convenienceFeeValue Float?        @default(0)
  config              Json?
  availableForCODOnly Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([method, gateway])
}

model PaymentSettlement {
  id               Int              @id @default(autoincrement())
  gateway          String
  settlementDate   DateTime
  settlementId     String?          @unique
  totalAmount      Float
  totalFees        Float
  netAmount        Float
  transactionCount Int
  status           SettlementStatus @default(PENDING)
  reconciledAt     DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  payments         Payment[]
}

model FraudCheck {
  id               Int         @id @default(autoincrement())
  phone            String
  totalOrders      Int         @default(0)
  delivered        Int         @default(0)
  returned         Int         @default(0)
  successRatio     Float       @default(0)
  fraudReportCount Int         @default(0)
  riskLevel        String      @default("Low")
  riskScore        Float       @default(0)
  computedStatus   FraudStatus @default(SAFE)
  userId           Int?
  checkedAt        DateTime    @default(now())
  user             User?       @relation(fields: [userId], references: [id])

  @@index([phone])
}

model Review {
  id          Int       @id @default(autoincrement())
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())
  isFeatured  Boolean   @default(false)
  isHidden    Boolean   @default(false)
  orderItemId Int       @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model SupportTicket {
  id           Int                    @id @default(autoincrement())
  subject      String
  message      String
  status       SupportStatus          @default(OPEN)
  priority     SupportPriority        @default(NORMAL)
  userId       Int
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  assignedToId Int?
  closedAt     DateTime?
  resolvedAt   DateTime?
  assignedTo   User?                  @relation("TicketAssignee", fields: [assignedToId], references: [id])
  user         User                   @relation(fields: [userId], references: [id])
  messages     SupportTicketMessage[]

  @@index([status])
  @@index([assignedToId])
}

model SupportTicketMessage {
  id             Int           @id @default(autoincrement())
  ticketId       Int
  authorId       Int?
  body           String
  isInternalNote Boolean       @default(false)
  createdAt      DateTime      @default(now())
  author         User?         @relation("TicketMessageAuthor", fields: [authorId], references: [id])
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model BlogCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isActive  Boolean    @default(true)
  order     Int        @default(0)
  posts     BlogPost[]
}

model SubCategoryBlogs {
  subCategoryId Int
  blogPostId    Int
  createdAt     DateTime    @default(now())
  blogPost      BlogPost    @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@id([subCategoryId, blogPostId])
}

model BlogPost {
  id            Int                @id @default(autoincrement())
  title         String
  slug          String             @unique
  content       String
  image         String?
  published     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  categoryId    Int
  category      BlogCategory       @relation(fields: [categoryId], references: [id])
  tags          BlogPostTag[]
  subCategories SubCategoryBlogs[]
}

model BlogPostTag {
  blogPostId Int
  tagId      Int
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
}

model Banner {
  id     Int     @id @default(autoincrement())
  title  String
  image  String
  link   String?
  active Boolean @default(true)
  device String?
}

model BroadBanner {
  id        String   @id @default(cuid())
  title     String
  image     String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UrgencyBanner {
  id        Int      @id @default(autoincrement())
  message   String
  eventType String?
  link      String?
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoBanner {
  id        Int               @id @default(autoincrement())
  text      String
  bgColor   String
  isActive  Boolean           @default(true)
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  title     String
  links     PromoBannerLink[]
}

model SeasonalCategory {
  id        Int       @id @default(autoincrement())
  title     String
  image     String
  link      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model HomepageGallery {
  id        Int      @id @default(autoincrement())
  name      String
  image     String
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isHeading Boolean  @default(false)
}

model PromoBannerLink {
  id       Int         @id @default(autoincrement())
  url      String
