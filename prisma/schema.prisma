// =====================
// Enhanced Payment System
// =====================
model Payment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  // Payment method details
  method        PaymentMethod
  methodDetails Json? // Store method-specific details like mobile number, bank account etc.

  // Which leg of the order's payment this transaction covers
  phase PaymentPhase @default(FULL)

  // Amount tracking
  amount         Float
  currency       String @default("BDT")
  paidAmount     Float  @default(0) // Track partial payments
  dueAmount      Float  @default(0) // Calculated field or set manually
  convenienceFee Float? @default(0) // Payment gateway fees charged to customer

  // Transaction tracking
  transactionId  String  @unique // Our internal unique transaction ID
  gatewayTranId  String? // Gateway transaction ID (before redirect)
  gatewayRefId   String? // Gateway reference ID (after validation)
  gatewayBatchId String? // For bulk payouts/refunds

  // Status tracking
  status             PaymentStatus      @default(PENDING)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  riskLevel          RiskLevel?         @default(LOW)

  // Gateway information
  gateway         String? // "SSLCOMMERZ", "BKASH", "NAGAD", "COD"
  gatewayResponse Json? // Store full gateway request/response
  rawResponse     Json? // Store full validation response

  // Timing
  initiatedAt DateTime  @default(now())
  verifiedAt  DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  refundedAt  DateTime?

  // Retry tracking
  retryCount  Int       @default(0)
  lastRetryAt DateTime?

  // Refund tracking
  refunds PaymentRefund[]

  // For COD payments
  collectedBy String? // delivery person, office staff
  collectedAt DateTime?

  // Audit
  notes    String? // Admin notes about payment issues
  metadata Json? // Additional flexible data

  // Relations
  paymentLogs PaymentLog[]

  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  paymentSettlement   PaymentSettlement? @relation(fields: [paymentSettlementId], references: [id])
  paymentSettlementId Int?

  @@index([orderId])
  @@index([gatewayTranId])
  @@index([transactionId])
  @@index([status])
  @@index([createdAt])
}

model PaymentRefund {
  id Int @id @default(autoincrement())

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id])

  returnRequestId Int?
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  amount Float
  reason String? // "CUSTOMER_REQUEST", "ORDER_CANCELLED", "DUPLICATE", etc.
  status RefundStatus @default(PENDING)

  // How the money actually goes back — gateway API call (SSL) vs a manual
  // bank/mobile-banking transfer an admin confirms by hand (COD, or gateways
  // we don't have a refund API integration for yet).
  refundMethod RefundMethod @default(MANUAL)

  gatewayRefundId String? // Gateway refund transaction ID (SSLCommerz refund_ref_id)
  gatewayResponse Json? // Full initiateRefund/refundQuery response, for audit

  requestedBy Int? // User ID (admin/customer)
  processedBy Int? // Admin ID who processed
  processedAt DateTime?

  notes    String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([returnRequestId])
  @@index([status])
}

enum RefundMethod {
  GATEWAY // refunded automatically via the payment gateway's refund API
  MANUAL // refunded by hand (bank transfer, bKash send-money, cash, etc.)
}

model PaymentLog {
  id Int @id @default(autoincrement())

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id])

  action          String // "INITIATED", "VERIFIED", "FAILED", "REFUNDED", etc.
  status          String
  message         String?
  gatewayResponse Json?

  ipAddress String?
  userAgent String?
  createdBy Int? // User/Admin ID

  createdAt DateTime @default(now())
}

model PaymentMethodConfig {
  id Int @id @default(autoincrement())

  method  PaymentMethod
  gateway String // "SSLCOMMERZ", "BKASH", etc.

  isEnabled Boolean @default(true)
  isSandbox Boolean @default(false)

  displayName  String
  displayOrder Int    @default(0)

  minAmount Float? // Minimum transaction amount
  maxAmount Float? // Maximum transaction amount

  convenienceFeeType  FeeType? // "FIXED" or "PERCENTAGE"
  convenienceFeeValue Float?   @default(0)

  config Json? // Store gateway-specific config (API keys, endpoints, etc.)

  availableForCODOnly Boolean @default(false) // For COD payments

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([method, gateway])
}

model PaymentSettlement {
  id Int @id @default(autoincrement())

  gateway        String
  settlementDate DateTime
  settlementId   String?  @unique // Gateway settlement ID

  totalAmount Float
  totalFees   Float
  netAmount   Float

  transactionCount Int

  status       SettlementStatus @default(PENDING)
  reconciledAt DateTime?

  payments Payment[]

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================
// Enums
// =====================
enum PaymentMethod {
  COD
  SSL
  BKASH
  NAGAD
  ROCKET
  BANK_TRANSFER
  CARD
  MOBILE_BANKING
}

enum PaymentStatus {
  PENDING // Initial state
  PROCESSING // Payment in progress
  PAID // Successfully paid
  PARTIALLY_PAID // Advance paid, remainder still due (Order.paymentStatus only)
  FAILED // Payment failed
  REFUNDED // Fully refunded
  PARTIALLY_REFUNDED // Partially refunded
  CANCELLED // Payment cancelled by user
  EXPIRED // Payment link expired
  ON_HOLD // Payment under review
}

enum PaymentPhase {
  FULL // Single payment covering the full order total
  ADVANCE // Deposit paid at checkout for a COD order requiring advance payment
  REMAINDER // Balance collected later (e.g. cash on delivery)
}

enum VerificationStatus {
  UNVERIFIED // Not yet verified
  VERIFIED // Successfully verified
  VERIFICATION_FAILED // Failed verification
  PENDING_REVIEW // Needs manual review
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

enum FraudStatus {
  SAFE
  SUSPICIOUS
  DOUBTFUL
  BLOCKED
}

model FraudCheck {
  id    Int    @id @default(autoincrement())
  phone String

  totalOrders      Int         @default(0)
  delivered        Int         @default(0)
  returned         Int         @default(0)
  successRatio     Float       @default(0)
  fraudReportCount Int         @default(0)
  riskLevel        String      @default("Low")
  riskScore        Float       @default(0)
  computedStatus   FraudStatus @default(SAFE)

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  checkedAt DateTime @default(now())

  @@index([phone])
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FeeType {
  FIXED
  PERCENTAGE
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RECONCILED
}

