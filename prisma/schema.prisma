generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// User
// =====================
model User {
  id         Int      @id @default(autoincrement())
  name       String?
  phone      String   @unique
  email      String?  @unique
  isVerified Boolean  @default(false)
  password   String?
  role       UserRole @default(CUSTOMER)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wishlist       Wishlist[]
  orders         Order[]
  // reviews        Review[]
  otps           OTP[]
  cart           Cart[]
  productViews   ProductView[]
  visitors       Visitor[]
  supportTickets SupportTicket[]
}

enum UserRole {
  SUPERADMIN
  PRODUCTMANAGER
  ORDERMANAGER
  SUPPORT
  CUSTOMER
}

model Visitor {
  id     String @id @default(cuid())
  user   User?  @relation(fields: [userId], references: [id])
  userId Int?

  carts     Cart[]
  views     ProductView[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// =====================
// Permission
// =====================
model FrontendPermission {
  id        Int        @id @default(autoincrement())
  name      String     @unique // e.g., VIEW_USER_MANAGEMENT
  path      String     @unique // e.g., /admin/users, /dashboard/analytics
  component String? // Component/Page name
  roles     UserRole[]
}

model BackendPermission {
  id       Int        @id @default(autoincrement())
  name     String     @unique // e.g., MANAGE_USERS
  endpoint String // e.g., /api/admin/users
  method   String? // GET, POST, PUT, DELETE, etc.
  resource String? // users, products, orders, etc.
  action   String? // create, read, update, delete, list
  roles    UserRole[]

  @@unique([endpoint, method]) // ✅ composite unique constraint
}

// =====================
// Auth / login
// =====================
model OTP {
  id        Int      @id @default(autoincrement())
  code      String
  email     String?
  type      String // email | phone
  // purpose   String // REGISTER | ADMIN_LOGIN | UPDATE_EMAIL | UPDATE_PHONE
  phone     String?
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model BlackListToken {
  id     Int    @id @default(autoincrement())
  jti    String
  expiry BigInt
}

model LoginAttempt {
  id           String    @id @default(cuid())
  identifier   String // email or IP
  attempts     Int       @default(0)
  blockedUntil DateTime?
  lastAttempt  DateTime  @default(now())

  @@unique([identifier])
}

// =====================
// Category & Subcategory & Room
// =====================
model Series {
  id     Int     @id @default(autoincrement())
  name   String
  slug   String  @unique
  image  String? // image URL
  notice String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id    Int     @id @default(autoincrement())
  name  String?
  slug  String  @unique
  image String? // image URL

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId Int

  subCategories SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, slug])
}

model SubCategory {
  id    Int     @id @default(autoincrement())
  name  String
  slug  String  @unique
  image String? // image URL

  sortOrder         Int     @default(0)
  isActive          Boolean @default(true)
  isAdvancePayment  Boolean @default(false)
  advancePercentage Int     @default(0)
  isCODAvailable    Boolean @default(true)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products           ProductSubCategory[]
  blogs              SubCategoryBlogs[]
  featuredCategories FeaturedCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
}

model SubCategoryBlogs {
  subCategoryId Int
  blogPostId    Int

  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  blogPost    BlogPost    @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([subCategoryId, blogPostId])
}

model ProductSubCategory {
  productId     Int
  subCategoryId Int

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@id([productId, subCategoryId])
}

// =====================
// Product & Variants
// =====================
model Product {
  id               Int     @id @default(autoincrement())
  title            String
  slug             String  @unique
  sku              String?
  description      String?
  basePrice        Int
  price            Int?
  brand            String?
  hasColorVariants Boolean @default(true)
  showColor        Boolean @default(true)

  discountType  String?
  discount      Int      @default(0)
  discountEnd   DateTime @default(now())
  discountStart DateTime @default(now())

  note             String?
  deliveryEstimate String?
  productDetails   String?
  dimension        String?
  shippingReturn   String?

  totalProductQuantity Int     @default(0)
  isActive             Boolean @default(true)
  isFeatured           Boolean @default(false)
  viewCount            Int     @default(0)
  soldCount            Int     @default(0)
  rating               Decimal @default(0.0) @db.Decimal(3, 2)
  trendScore           Decimal @default(0.0) @db.Decimal(3, 2)
  sortOrder            Int     @default(0)

  material      Material?            @relation(fields: [materialId], references: [id])
  materialId    Int?
  orderItems    OrderItem[]
  wishlists     Wishlist[]
  images        ProductImage[]
  subCategories ProductSubCategory[]
  colors        ProductColor[]
  // reviews       Review[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  productViews ProductView[]
  productTags  ProductTag[]
}

model Tag {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  // slug     String  @unique
  isActive Boolean @default(true)

  products ProductTag[]
  blogs    BlogPostTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductTag {
  productId Int
  tagId     Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductView {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id])
  productId Int

  user   User? @relation(fields: [userId], references: [id])
  userId Int?

  visitor   Visitor? @relation(fields: [visitorId], references: [id])
  visitorId String?

  viewCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId, visitorId])
}

model Material {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  slug     String  @unique
  order    Int     @default(0)
  isActive Boolean @default(true)

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model ProductImage {
  id       Int    @id @default(autoincrement())
  image    String
  serialNo Int    @default(0)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductColor {
  id               Int     @id @default(autoincrement())
  useDefaultImages Boolean @default(true)

  color   Color @relation(fields: [colorId], references: [id])
  colorId Int

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  images ProductColorImage[]
  sizes  ProductSize[]
}

model ProductColorImage {
  id       Int    @id @default(autoincrement())
  image    String
  serialNo Int    @default(0)

  productColorId Int
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
}

model Color {
  id        Int     @id @default(autoincrement())
  name      String
  hexCode   String?
  image     String?
  sortOrder Int     @default(0)

  productColor ProductColor[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ProductSize {
  id Int @id @default(autoincrement())

  sku       String?
  basePrice Int?
  price     Int?
  quantity  Int     @default(0)

  soldCount Int @default(0)

  sizeId Int
  size   Size @relation(fields: [sizeId], references: [id])

  colorId   Int
  color     ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
}

model Variant {
  id    Int    @id @default(autoincrement())
  name  String
  sizes Size[] // one-to-many relation

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Size {
  id        Int     @id @default(autoincrement())
  name      String
  variantId Int
  variant   Variant @relation(fields: [variantId], references: [id])

  productSize ProductSize[]

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// =====================
// Cart
// =====================
model Cart {
  id        Int     @id @default(autoincrement())
  user      User?   @relation(fields: [userId], references: [id])
  userId    Int?
  userEmail String?

  baseSubtotalAtAdd Int @default(0)
  subtotalAtAdd     Int @default(0)

  coupon   Coupon? @relation(fields: [couponId], references: [id])
  couponId Int?

  items     CartItem[]
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  visitor   Visitor?   @relation(fields: [visitorId], references: [id])
  visitorId String?

  @@index([userId, status])
}

model CartItem {
  id     Int  @id @default(autoincrement())
  cart   Cart @relation(fields: [cartId], references: [id])
  cartId Int

  quantity Int @default(1)

  basePriceAtAdd    Int
  baseSubtotalAtAdd Int

  priceAtAdd    Int
  subtotalAtAdd Int

  color String?
  size  String?

  productSize   ProductSize @relation(fields: [productSizeId], references: [id])
  productSizeId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productSizeId])
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

// =====================
// Orders
// =====================
model Order {
  id Int @id @default(autoincrement())

  orderId       String @unique
  trackingToken String @unique

  user            User?     @relation(fields: [userId], references: [id])
  userId          Int?
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String
  districtId      Int?
  district        District? @relation(fields: [districtId], references: [id])
  districtName    String?

  deliveryMethod String?
  deliveryCharge Float?

  couponCode String?
  discount   Float?

  total     Float
  status    OrderStatus @default(PENDING)
  awbNumber String? // courier AWB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                OrderItem[]
  payments             Payment[]
  orderStatusHistories OrderStatusHistory[]
}

model OrderItem {
  id      Int @id @default(autoincrement())
  orderId Int

  product      Product @relation(fields: [productId], references: [id])
  productId    Int
  productTitle String // snapshot
  sku          String?

  color      String?
  size       String?
  isReviewed Boolean @default(false)

  quantity             Int
  priceAtPurchase      Int
  basePriceAtPurchase  Int
  totalPriceAtPurchase Int

  order  Order   @relation(fields: [orderId], references: [id])
  review Review?
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  note      String? // optional admin note
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum DeliveryMethod {
  HOME
  PICKUP
  COURIER
}

model District {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  isActive       Boolean  @default(true)
  deliveryFee    Int      @default(120)
  isCODAvailable Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}

model Coupon {
  id   Int    @id @default(autoincrement())
  code String @unique

  discountType  CouponDiscountType
  discountValue Float? // percentage or fixed amount or null for free delivery
  minOrderValue Float? // minimum order value to apply coupon
  maxDiscount   Float? // maximum discount amount for percentage type
  expiryDate    DateTime
  startDate     DateTime           @default(now())

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  carts     Cart[]
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

// =====================
// Enhanced Payment System
// =====================

model Payment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  // Payment method details
  method        PaymentMethod
  methodDetails Json? // Store method-specific details like mobile number, bank account etc.

  // Amount tracking
  amount         Float
  currency       String @default("BDT")
  paidAmount     Float  @default(0) // Track partial payments
  dueAmount      Float  @default(0) // Calculated field or set manually
  convenienceFee Float? @default(0) // Payment gateway fees charged to customer

  // Transaction tracking
  transactionId  String  @unique // Our internal unique transaction ID
  gatewayTranId  String? // Gateway transaction ID (before redirect)
  gatewayRefId   String? // Gateway reference ID (after validation)
  gatewayBatchId String? // For bulk payouts/refunds

  // Status tracking
  status             PaymentStatus      @default(PENDING)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  riskLevel          RiskLevel?         @default(LOW)

  // Gateway information
  gateway         String? // "SSLCOMMERZ", "BKASH", "NAGAD", "COD"
  gatewayResponse Json? // Store full gateway request/response
  rawResponse     Json? // Store full validation response

  // Timing
  initiatedAt DateTime  @default(now())
  verifiedAt  DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  refundedAt  DateTime?

  // Retry tracking
  retryCount  Int       @default(0)
  lastRetryAt DateTime?

  // Refund tracking
  refunds PaymentRefund[]

  // For COD payments
  collectedBy String? // delivery person, office staff
  collectedAt DateTime?

  // Audit
  notes    String? // Admin notes about payment issues
  metadata Json? // Additional flexible data

  // Relations
  paymentLogs PaymentLog[]

  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  paymentSettlement   PaymentSettlement? @relation(fields: [paymentSettlementId], references: [id])
  paymentSettlementId Int?

  @@index([orderId])
  @@index([gatewayTranId])
  @@index([transactionId])
  @@index([status])
  @@index([createdAt])
}

model PaymentRefund {
  id Int @id @default(autoincrement())

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id])

  amount Float
  reason String? // "CUSTOMER_REQUEST", "ORDER_CANCELLED", "DUPLICATE", etc.
  status RefundStatus @default(PENDING)

  gatewayRefundId String? // Gateway refund transaction ID

  requestedBy Int? // User ID (admin/customer)
  processedBy Int? // Admin ID who processed
  processedAt DateTime?

  notes    String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentLog {
  id Int @id @default(autoincrement())

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id])

  action          String // "INITIATED", "VERIFIED", "FAILED", "REFUNDED", etc.
  status          String
  message         String?
  gatewayResponse Json?

  ipAddress String?
  userAgent String?
  createdBy Int? // User/Admin ID

  createdAt DateTime @default(now())
}

model PaymentMethodConfig {
  id Int @id @default(autoincrement())

  method  PaymentMethod
  gateway String // "SSLCOMMERZ", "BKASH", etc.

  isEnabled Boolean @default(true)
  isSandbox Boolean @default(false)

  displayName  String
  displayOrder Int    @default(0)

  minAmount Float? // Minimum transaction amount
  maxAmount Float? // Maximum transaction amount

  convenienceFeeType  FeeType? // "FIXED" or "PERCENTAGE"
  convenienceFeeValue Float?   @default(0)

  config Json? // Store gateway-specific config (API keys, endpoints, etc.)

  availableForCODOnly Boolean @default(false) // For COD payments

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentSettlement {
  id Int @id @default(autoincrement())

  gateway        String
  settlementDate DateTime
  settlementId   String?  @unique // Gateway settlement ID

  totalAmount Float
  totalFees   Float
  netAmount   Float

  transactionCount Int

  status       SettlementStatus @default(PENDING)
  reconciledAt DateTime?

  payments Payment[]

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================
// Enums
// =====================

enum PaymentMethod {
  COD
  SSL
  BKASH
  NAGAD
  ROCKET
  BANK_TRANSFER
  CARD
  MOBILE_BANKING
}

enum PaymentStatus {
  PENDING // Initial state
  PROCESSING // Payment in progress
  PAID // Successfully paid
  FAILED // Payment failed
  REFUNDED // Fully refunded
  PARTIALLY_REFUNDED // Partially refunded
  CANCELLED // Payment cancelled by user
  EXPIRED // Payment link expired
  ON_HOLD // Payment under review
}

enum VerificationStatus {
  UNVERIFIED // Not yet verified
  VERIFIED // Successfully verified
  VERIFICATION_FAILED // Failed verification
  PENDING_REVIEW // Needs manual review
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FeeType {
  FIXED
  PERCENTAGE
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RECONCILED
}

// =====================
// Reviews
// =====================
model Review {
  id          Int       @id @default(autoincrement())
  rating      Int
  comment     String?
  orderItemId Int       @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  // product   Product @relation(fields: [productId], references: [id])
  // productId Int
  // user        User      @relation(fields: [userId], references: [id])
  // userId      Int

  isHidden   Boolean @default(false)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
}

// =====================
// Wishlist
// =====================
model Wishlist {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

// =====================
// HELP / SUPPORT
// =====================
model SupportTicket {
  id      Int    @id @default(autoincrement())
  subject String
  message String

  status   SupportStatus   @default(OPEN)
  priority SupportPriority @default(NORMAL)

  user   User @relation(fields: [userId], references: [id])
  userId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
}

// =====================
// Blog / CMS
// =====================
model BlogCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String
  image     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId Int
  category   BlogCategory @relation(fields: [categoryId], references: [id])

  tags          BlogPostTag[]
  subCategories SubCategoryBlogs[]
}

model BlogPostTag {
  blogPostId Int
  tagId      Int

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
}

model Banner {
  id     Int     @id @default(autoincrement())
  title  String?
  image  String
  link   String?
  active Boolean @default(true)
}

model HomepageBanner {
  id        Int      @id @default(autoincrement())
  image     String
  sortOrder Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoBanner {
  id        Int      @id @default(autoincrement())
  text      String
  bgColor   String // e.g. "#0f172a"
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links PromoBannerLink[]
}

model PromoBannerLink {
  id   Int    @id @default(autoincrement())
  text String
  url  String

  bannerId Int
  banner   PromoBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
}

model FeaturedCategory {
  id        Int     @id @default(autoincrement())
  image     String
  sortOrder Int
  isActive  Boolean @default(true)

  subcategory   SubCategory @relation(fields: [subCategoryId], references: [id])
  subCategoryId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String
  createdAt DateTime @default(now())
}

// =====================
// SEO
// =====================
model SEO {
  id Int @id @default(autoincrement())

  title       String?
  description String?
  keywords    String?
  canonical   String?

  ogTitle       String?
  ogDescription String?
  ogImage       String?

  noIndex  Boolean @default(false)
  noFollow Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
