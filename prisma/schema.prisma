model ActivityLog {
  id      Int  @id @default(autoincrement())
  adminId Int
  admin   User @relation(fields: [adminId], references: [id])

  // What happened
  action   String // "UPDATE_PRODUCT", "DELETE_ORDER"
  module   LogModule // PRODUCT, ORDER, etc.
  severity LogSeverity @default(INFO)
  status   LogStatus   @default(SUCCESS)

  // What was affected
  targetId    String? // Database ID of affected record
  targetLabel String? // Human-readable name at time of action

  // What changed
  oldValue Json? // Previous state
  newValue Json? // New state
  metadata Json? // Extra context

  // Who, where, when
  ipAddress String?
  userAgent String?
  sessionId String? // Group related actions

  statement String?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([module])
  @@index([createdAt])
  @@index([targetId])
}

enum LogModule {
  CATALOG
  PRODUCT
  ORDER
  USER
  MARKETING
  INVENTORY
  CONTENT
  SUPPORT
  AUTH
  SYSTEM
}

enum LogSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum LogStatus {
  SUCCESS
  FAILED
  PENDING
}

